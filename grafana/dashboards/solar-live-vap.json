    {
      "id": 1,
      "title": "Live snapshots",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb_solar"
      },
      "fieldConfig": {
        "defaults": {
          "displayName": "${__field.name}",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/ V$/"
            },
            "properties": [
              {
                "id": "unit",
                "value": "volt"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/ A$/"
            },
            "properties": [
              {
                "id": "unit",
                "value": "amp"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/ P$/"
            },
            "properties": [
              {
                "id": "unit",
                "value": "watt"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/SOC|soc/"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/°C|Temp/"
            },
            "properties": [
              {
                "id": "unit",
                "value": "celsius"
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb_solar"
          },
          "query": "from(bucket: \"solar_raw\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"solar\" and r._field == \"value\")\n  |> filter(fn: (r) => r.device == \"${device}\")\n  |> filter(fn: (r) =>\n      (r.component == \"pv1\" and (r.metric == \"voltage\" or r.metric == \"current\" or r.metric == \"power\")) or\n      (r.component == \"pv2\" and (r.metric == \"voltage\" or r.metric == \"current\" or r.metric == \"power\")) or\n      (r.component == \"battery\" and (r.metric == \"voltage\" or r.metric == \"current\" or r.metric == \"power\" or r.metric == \"temperature\" or r.metric == \"soc\")) or\n      (r.component == \"grid\" and r.metric == \"voltage\") or\n      (r.component == \"load\" and r.metric == \"current\") or\n      (r.component == \"house\" and r.metric == \"power\") or\n      (r.component == \"inverter\" and r.metric == \"temperature\")\n  )\n  |> last()\n  |> map(fn: (r) => ({\n      r with _field:\n        if r.component == \"pv1\" and r.metric == \"voltage\" then \"PV1 V\"\n        else if r.component == \"pv1\" and r.metric == \"current\" then \"PV1 A\"\n        else if r.component == \"pv1\" and r.metric == \"power\" then \"PV1 P\"\n        else if r.component == \"pv2\" and r.metric == \"voltage\" then \"PV2 V\"\n        else if r.component == \"pv2\" and r.metric == \"current\" then \"PV2 A\"\n        else if r.component == \"pv2\" and r.metric == \"power\" then \"PV2 P\"\n        else if r.component == \"battery\" and r.metric == \"voltage\" then \"Batt V\"\n        else if r.component == \"battery\" and r.metric == \"current\" then \"Batt A\"\n        else if r.component == \"battery\" and r.metric == \"power\" then \"Batt P\"\n        else if r.component == \"battery\" and r.metric == \"soc\" then \"Batt SOC\"\n        else if r.component == \"battery\" and r.metric == \"temperature\" then \"Batt °C\"\n        else if r.component == \"grid\" and r.metric == \"voltage\" then \"AC V\"\n        else if r.component == \"load\" and r.metric == \"current\" then \"Load A\"\n        else if r.component == \"house\" and r.metric == \"power\" then \"House P\"\n        else if r.component == \"inverter\" and r.metric == \"temperature\" then \"Inv °C\"\n        else r.component + \" \" + r.metric\n  }))"
        }
      ]
    },
