      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb_solar"
          },
          "query": "from(bucket: \"solar_raw\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"solar\" and r._field == \"value\")\n  |> filter(fn: (r) => r.device == \"${device}\")\n  |> filter(fn: (r) =>\n      (r.component == \"pv1\" or r.component == \"pv2\") and\n      (r.metric == \"voltage\" or r.metric == \"current\" or r.metric == \"power\")\n  )\n  |> map(fn: (r) => ({\n      r with _field:\n        if r.metric == \"voltage\" then r.component + \" V\"\n        else if r.metric == \"current\" then r.component + \" A\"\n        else r.component + \" P\"\n  }))\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> yield(name: \"pv\")"
        }
