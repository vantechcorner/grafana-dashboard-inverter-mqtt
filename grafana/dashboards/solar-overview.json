    {
      "id": 10,
      "title": "Power flows",
      "type": "timeseries",
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb_solar"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 15,
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          },
          "color": {
            "mode": "palette-classic"
          },
          "displayName": "${__field.name}"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb_solar"
          },
          "query": "from(bucket: \"solar_raw\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"solar\" and r._field == \"value\")\n  |> filter(fn: (r) => r.device == \"${device}\")\n  |> filter(fn: (r) =>\n      (r.component == \"pv1\" and r.metric == \"power\") or\n      (r.component == \"pv2\" and r.metric == \"power\") or\n      (r.component == \"battery\" and r.metric == \"power\") or\n      (r.component == \"grid\" and r.metric == \"power_ct\") or\n      (r.component == \"load\" and r.metric == \"power\") or\n      (r.component == \"house\" and r.metric == \"power\") or\n      (r.component == \"inverter\" and r.metric == \"power\")\n  )\n  |> map(fn: (r) => ({\n      r with _field:\n        if r.component == \"grid\" then \"grid\"\n        else if r.component == \"house\" then \"house\"\n        else r.component\n  }))\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> yield(name: \"mean\")"
        }
