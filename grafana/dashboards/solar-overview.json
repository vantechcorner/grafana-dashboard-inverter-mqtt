      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb_solar"
          },
          "query": "import \"timezone\"\noption location = timezone.fixed(offset: 7h)\n\nfrom(bucket: \"solar_raw\")\n  |> range(start: today())\n  |> filter(fn: (r) => r._measurement == \"solar\" and r._field == \"value\")\n  |> filter(fn: (r) => r.device == \"${device}\")\n  |> filter(fn: (r) => (r.component == \"pv1\" or r.component == \"pv2\") and r.metric == \"power\")\n  |> aggregateWindow(every: 1m, fn: max, createEmpty: false)\n  |> group(columns: [\"_time\"])\n  |> sum(column: \"_value\")\n  |> group()\n  |> max()\n  |> map(fn: (r) => ({ r with _value: r._value / 1000.0, _field: \"PV\" }))"
        }
      ]
    },
