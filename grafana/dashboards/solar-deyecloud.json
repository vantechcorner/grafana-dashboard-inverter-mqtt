            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "text": {
          "titleSize": 14,
          "valueSize": 34
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb_solar"
          },
          "query": "import \"timezone\"\nimport \"date\"\noption location = timezone.fixed(offset: 7h)\n\nday0 = today()\n\npast = from(bucket: \"solar_1d\")\n  |> range(start: 2026-08-01T00:00:00Z, stop: day0)\n  |> filter(fn: (r) => r._measurement == \"solar\" and r._field == \"value\")\n  |> filter(fn: (r) => r.device == \"${device}\")\n  |> filter(fn: (r) => r.component == \"pv\" and r.metric == \"energy_today\")\n  |> aggregateWindow(every: 1d, fn: last, createEmpty: false, timeSrc: \"_start\")\n\ncur = from(bucket: \"solar_raw\")\n  |> range(start: day0)\n  |> filter(fn: (r) => r._measurement == \"solar\" and r._field == \"value\")\n  |> filter(fn: (r) => r.device == \"${device}\")\n  |> filter(fn: (r) => r.component == \"pv\" and r.metric == \"energy_today\")\n  |> last()\n  |> map(fn: (r) => ({ r with _time: day0 }))\n\nunion(tables: [past, cur])\n  |> sum()\n  |> map(fn: (r) => ({ _time: now(), _field: \"Production\", _value: r._value }))\n  |> keep(columns: [\"_time\", \"_field\", \"_value\"])\n"
        }
      ],
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(?!Time$).+"
            }
          }
        }
      ]
    },
