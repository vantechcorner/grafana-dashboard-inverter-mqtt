          "query": "import \"timezone\"\nimport \"date\"\noption location = timezone.fixed(offset: 7h)\n\nperiodStart = if \"${period}\" == \"month\" then date.truncate(t: now(), unit: 1mo)\n  else if \"${period}\" == \"year\" then date.truncate(t: now(), unit: 1y)\n  else date.add(d: -60d, to: now())\nmonthStop = date.add(d: 1mo, to: date.truncate(t: now(), unit: 1mo))\nhistStart = periodStart\nhistStop = if \"${period}\" == \"month\" then monthStop else now()\nday0 = today()\nstopPast = if histStop < day0 then histStop else day0\n\nmapHist = (r) => ({\n      _time: r._time,\n      _field:\n        if r.metric == \"energy_today\" and r.component == \"pv\" then \"Daily Production\"\n        else if r.metric == \"energy_today\" and r.component == \"house\" then \"Daily Consumption\"\n        else if r.metric == \"buy_today\" then \"Daily Purchased\"\n        else if r.metric == \"sell_today\" then \"Daily Grid Feed In\"\n        else if r.metric == \"charge_today\" then \"Daily Charge\"\n        else \"Daily Discharge\",\n      _value:\n        if r.metric == \"charge_today\" or r.metric == \"buy_today\" or (r.metric == \"energy_today\" and r.component == \"house\")\n          then 0.0 - r._value\n        else r._value\n  })\n\npast = from(bucket: \"solar_1d\")\n  |> range(start: histStart, stop: stopPast)\n  |> filter(fn: (r) => r._measurement == \"solar\" and r._field == \"value\")\n  |> filter(fn: (r) => r.device == \"${device}\")\n  |> filter(fn: (r) =>\n      (r.component == \"pv\" and r.metric == \"energy_today\") or\n      (r.component == \"house\" and r.metric == \"energy_today\") or\n      (r.component == \"grid\" and r.metric == \"buy_today\") or\n      (r.component == \"grid\" and r.metric == \"sell_today\") or\n      (r.component == \"battery\" and r.metric == \"charge_today\") or\n      (r.component == \"battery\" and r.metric == \"discharge_today\")\n  )\n  |> map(fn: mapHist)\n  |> group(columns: [\"_field\"])\n  |> aggregateWindow(every: 1d, fn: last, createEmpty: true, timeSrc: \"_start\")\n\ncur = from(bucket: \"solar_raw\")\n  |> range(start: day0, stop: histStop)\n  |> filter(fn: (r) => r._measurement == \"solar\" and r._field == \"value\")\n  |> filter(fn: (r) => r.device == \"${device}\")\n  |> filter(fn: (r) =>\n      (r.component == \"pv\" and r.metric == \"energy_today\") or\n      (r.component == \"house\" and r.metric == \"energy_today\") or\n      (r.component == \"grid\" and r.metric == \"buy_today\") or\n      (r.component == \"grid\" and r.metric == \"sell_today\") or\n      (r.component == \"battery\" and r.metric == \"charge_today\") or\n      (r.component == \"battery\" and r.metric == \"discharge_today\")\n  )\n  |> map(fn: mapHist)\n  |> group(columns: [\"_field\"])\n  |> aggregateWindow(every: 1d, fn: last, createEmpty: true, timeSrc: \"_start\")\n\nunion(tables: [past, cur])\n  |> fill(column: \"_value\", value: 0.0)\n  |> keep(columns: [\"_time\", \"_field\", \"_value\"])\n  |> yield(name: \"history\")\n"
