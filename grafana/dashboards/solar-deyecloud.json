      "id": 20,
      "title": "Accumulative production",
      "type": "stat",
      "gridPos": {
        "h": 3,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb_solar"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "kWh",
          "decimals": 2,
          "displayName": "${__field.name}",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
