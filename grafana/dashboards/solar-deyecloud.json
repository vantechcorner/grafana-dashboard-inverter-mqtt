  "panels": [
    {
      "id": 10,
      "title": "PV",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb_solar"
      },
      "fieldConfig": {
        "defaults": {
          "unit": " W",
          "decimals": 0,
          "displayName": "${__field.name}",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "text": {
          "titleSize": 14,
          "valueSize": 36
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb_solar"
          },
          "query": "from(bucket: \"solar_raw\")\n  |> range(start: -5m)\n  |> filter(fn: (r) => r._measurement == \"solar\" and r._field == \"value\")\n  |> filter(fn: (r) => r.device == \"${device}\")\n  |> filter(fn: (r) => (r.component == \"pv1\" or r.component == \"pv2\") and r.metric == \"power\")\n  |> last()\n  |> group()\n  |> sum(column: \"_value\")\n  |> map(fn: (r) => ({ _time: now(), _field: \"PV\", _value: r._value }))\n  |> keep(columns: [\"_time\", \"_field\", \"_value\"])\n"
        }
      ],
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(?!Time$).+"
            }
          }
        }
      ]
    },
